# Aliases. Sourced from ~/.zshrc -- keep this file alias-only;
# functions live in ~/.zsh_functions.

# ls and friends
alias ls='ls -G'
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias lls='long_ls'          # long_ls() is defined in ~/.zsh_functions

# grep with color
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

# editors and shell
alias vim='nvim'
alias c='clear'
alias e='exit'
alias ez='vim ~/.zshrc'
alias ea='vim ~/.zsh_aliases'
alias ef='vim ~/.zsh_functions'
alias sz='source ~/.zshrc'

# git
alias lg='lazygit'

# python venvs
alias activate='source .venv/bin/activate'

# Notify when a long-running command finishes. Use like so:
#   sleep 10; alert
if command -v notify-send >/dev/null 2>&1; then
  alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'
elif command -v osascript >/dev/null 2>&1; then
  alias alert='osascript -e "display notification \"$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')\" with title \"$([ $? = 0 ] && echo Done || echo Error)\""'
fi
