# Command-line tools
brew "colima", restart_service: :changed  # Docker runtime, runs as a login service
brew "coreutils"   # GNU File, Shell, and Text utilities
brew "docker"      # Docker CLI (talks to colima, see .zshrc)
brew "docker-compose"  # Multi-container Docker apps
brew "fd"          # Simple, fast and user-friendly alternative to find
brew "ffmpeg"      # Audio/video converter (yt-dlp uses it for the dl function)
brew "gh"          # GitHub command-line tool
brew "git-filter-repo"  # Rewrite git history, e.g. to strip a leaked secret
brew "git-lfs"     # Git extension for large files (the gitconfig requires it)
brew "jj"          # Jujutsu, a Git-compatible version control system
brew "jq"          # Command-line JSON processor
brew "lazygit"     # Terminal UI for git
brew "neovim"      # Editor (config: LazyVim)
brew "node"        # JavaScript runtime (LazyVim language servers use it)
brew "python"      # Python 3
brew "ripgrep"     # Fast grep (LazyVim search uses it)
brew "tmux"        # Terminal multiplexer
brew "yt-dlp"      # Video and audio downloader (the dl function uses it)

# Apps and fonts
cask "kitty"                 # GPU terminal emulator
cask "font-hack-nerd-font"   # Font used by the kitty config
